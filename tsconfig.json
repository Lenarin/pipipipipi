{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "moduleResolution": "bundler", "allowImportingTsExtensions": true, "isolatedModules": true,
    "moduleDetection": "force", "noEmit": true, "strict": true, "strictPropertyInitialization": false,
    "skipLibCheck": true, "noFallthroughCasesInSwitch": true, "types": ["vite/client"]
  },
  "include": ["src"]
}
